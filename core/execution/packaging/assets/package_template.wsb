<Configuration>
  <!--
    ArchitectOS Windows packaging sandbox — fixed, reviewed configuration.
    Networking and every integration that is not needed for a local build are
    disabled. Only three read-only inputs and one writable output are mapped.
  -->
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <PrinterRedirection>Disable</PrinterRedirection>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>__INPUT__</HostFolder>
      <SandboxFolder>C:\pkg\in</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__PYTHON__</HostFolder>
      <SandboxFolder>C:\pkg\py</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__SITE__</HostFolder>
      <SandboxFolder>C:\pkg\sp</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__OUTPUT__</HostFolder>
      <SandboxFolder>C:\pkg\out</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\pkg\in\build_sandbox.ps1</Command>
  </LogonCommand>
</Configuration>
